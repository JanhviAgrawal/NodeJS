<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= story.story_name %> | Stories
    </title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #0f1014;
            color: #f5f5f7;
            font-family: 'Inter', sans-serif;
            padding-bottom: 50px;
        }

        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 10;
            background: rgba(0, 0, 0, 0.5);
            color: white;
            padding: 8px 15px;
            border-radius: 50px;
            text-decoration: none;
            backdrop-filter: blur(10px);
            transition: 0.3s;
        }

        .back-btn:hover {
            background: #e50914;
            color: white;
        }

        .banner-container {
            width: 100%;
            height: 60vh;
            position: relative;
            overflow: hidden;
        }

        .banner-image {
            width: 100%;
            height: 140%;
            object-fit: cover;
        }

        .banner-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, #0f1014 10%, transparent 90%);
        }

        .story-content {
            max-width: 800px;
            margin: -100px auto 0;
            position: relative;
            z-index: 5;
            padding: 0 20px;
        }

        .story-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
        }

        .meta-info {
            color: #8f98b2;
            font-weight: 600;
            margin-bottom: 30px;
            display: flex;
            gap: 15px;
            text-transform: uppercase;
            font-size: 0.9rem;
        }

        .description-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #bdc3d1;
            white-space: pre-line;
            /* This preserves the paragraphs from your textarea */
        }

        .action-bars {
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid #252833;
            display: flex;
            gap: 15px;
        }

        .btn-edit {
            background: #252833;
            color: white;
            border: none;
        }

        .btn-edit:hover {
            background: #323745;
            color: white;
        }

        .btn-delete {
            background: rgba(229, 9, 20, 0.1);
            color: #ff4d4d;
            border: 1px solid rgba(229, 9, 20, 0.2);
        }

        .btn-delete:hover {
            background: #e50914;
            color: white;
        }
    </style>
</head>

<body>

    <a href="/" class="back-btn"><i class="bi bi-arrow-left"></i> Back to Home</a>

    <div class="banner-container">
        <img src="/uploads/<%= story.story_image_horizontal %>" class="banner-image">
        <div class="banner-overlay"></div>
    </div>

    <div class="story-content">
        <h1 class="story-title">
            <%= story.story_name %>
        </h1>

        <div class="meta-info">
            <span><i class="bi bi-grid"></i>
                <%= story.story_category.join(', ') %></span>
            <span><i class="bi bi-translate"></i> Japanese Reads</span>
        </div>

        <div class="description-text">
            <% 
               // This splits the description into paragraphs based on new lines
               let paragraphs = story.story_description.split(' \n'); paragraphs.forEach(function(para) {
                    if(para.trim().length> 0) { %>
                    <p>
                        <%= para %>
                    </p>
                    <% } }); %>
        </div>

        <div class="action-bars">
            <a href="/edit/<%= story._id %>" class="btn btn-edit px-4 py-2">
                <i class="bi bi-pencil-square"></i> Edit Story
            </a>
            <a href="/deleteStory/<%= story._id %>" class="btn btn-delete px-4 py-2">
                <i class="bi bi-trash"></i> Delete Story
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stories</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-body: #0f1014;
            --bg-sidebar: rgba(15, 16, 20, 0.95);
            --bg-card: #16181f;
            --text-primary: #f5f5f7;
            --text-secondary: #8f98b2;
            --sidebar-width: 100px;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(to right, rgba(0, 0, 0, 1) 0%, transparent 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 50px 48px;
            z-index: 1000;
        }

        .nav-icon {
            color: var(--text-secondary);
            font-size: 1.5rem;
            margin-bottom: 2.5rem;
            transition: 0.3s ease;
            text-decoration: none;
        }

        .nav-icon:hover,
        .nav-icon.active {
            color: white;
            transform: scale(1.1);
        }

        .sidebar-footer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .btn-add {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: #e50914;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(229, 9, 20, 0.3);
        }

        .content-container {
            padding-left: 140px;
        }

        .hero-section {
            margin-left: -37px;
            margin-bottom: 3rem;
            border-radius: 0 0 30px 30px;
            overflow: hidden;
            position: relative;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 150px;
            background: linear-gradient(to top, var(--bg-body), transparent);
        }

        .category-title {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            margin-top: 2rem;
            color: #fff;
            letter-spacing: -0.5px;
        }

        .carousel-container {
            position: relative;
            padding: 0 40px;
        }

        /* ========================= */
        /* 🎯 CAROUSEL FIXES */
        /* ========================= */

        .carousel {
            overflow: hidden;
        }

        .carousel-item {
            transition: transform 0.6s ease;
            will-change: transform;
        }

        .carousel-item>.row {
            margin: 0;
        }

        /* ========================= */
        /* 🎯 CAROUSEL CONTROLS */
        /* ========================= */

        .carousel-control-prev,
        .carousel-control-next {
            width: 60px;
            height: 100%;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 100;
            border: none;
        }

        .carousel-control-prev {
            background: linear-gradient(to right,
                    rgba(15, 16, 20, 0.95),
                    rgba(15, 16, 20, 0));
        }

        .carousel-control-next {
            background: linear-gradient(to left,
                    rgba(15, 16, 20, 0.95),
                    rgba(15, 16, 20, 0));
        }

        .carousel-container:hover .carousel-control-prev,
        .carousel-container:hover .carousel-control-next {
            opacity: 1;
        }

        .carousel-control-prev i {
            margin-left: 12px;
        }

        .carousel-control-next i {
            margin-right: 12px;
        }

        /* ========================= */
        /* 🎯 CARD STYLES */
        /* ========================= */

        .card-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 2 / 2.8;
            border-radius: 12px;
            cursor: pointer;
            transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            z-index: 1;
            transform-origin: center center;
            backface-visibility: hidden;
            will-change: transform;
        }

        .card-wrapper:hover {
            transform: scale(1.08);
            z-index: 1500;
        }

        .main-poster {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
        }

        /* Default popout (expand RIGHT) */
        .card-popout {
            position: absolute;
            top: 0;
            left: 0;
            width: 140%;
            height: 110%;
            background-color: var(--bg-card);
            border-radius: 12px;
            opacity: 0;
            visibility: hidden;
            display: flex;
            flex-direction: column;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8);
            z-index: 2000;
            overflow: hidden;
            transform-origin: left center;
        }

        /* Edge-aware fix: last & second-last cards expand LEFT */
        .carousel-item .col:nth-last-child(1) .card-popout,
        .carousel-item .col:nth-last-child(2) .card-popout {
            left: auto;
            right: 0;
            transform-origin: right center;
        }

        .card-wrapper:hover .card-popout {
            opacity: 1;
            visibility: visible;
        }

        .card-popout img {
            height: 180px !important;
            width: 100%;
            object-fit: cover;
        }

        .popout-body {
            padding: 1rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: linear-gradient(to bottom, transparent, #16181f 20%);
        }

        .item-name {
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            margin: 0;
            line-height: 1.2;
        }

        .item-desc {
            font-size: 0.8rem;
            color: var(--text-secondary);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin: 0;
        }

        .watch-now-btn {
            margin-top: auto;
            background: #fff;
            color: #000;
            border: none;
            padding: 6px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.8rem;
            width: 100%;
        }

        .section-block {
            margin-bottom: 4rem;
        }

        /* 🔓 Allow card popout to escape carousel clipping */
        .carousel,
        .carousel-inner,
        .carousel-item,
        .carousel-item .row,
        .carousel-item .col {
            overflow: visible !important;
        }
    </style>


</head>

<body>
    <aside class="sidebar">
        <a href="/" class="nav-icon active"><i class="bi bi-house-door-fill"></i></a>
        <a href="#" class="nav-icon"><i class="bi bi-search"></i></a>
        <a href="#" class="nav-icon"><i class="bi bi-tv"></i></a>
        <a href="#" class="nav-icon"><i class="bi bi-grid-fill"></i></a>
        <div class="sidebar-footer">
            <a href="/addStory" class="btn-add"><i class="bi bi-plus-lg"></i></a>
            <a href="#" class="nav-icon mb-0"><i class="bi bi-person-circle"></i></a>
        </div>
    </aside>

    <div class="content-container">
        <section class="hero-section">
            <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active"><img src="/images/image1.webp" class="d-block w-100"
                            style="height: 520px; object-fit: cover;"></div>
                    <div class="carousel-item"><img src="/images/image2.jpg" class="d-block w-100"
                            style="height: 520px; object-fit: cover;"></div>
                    <div class="carousel-item"><img src="/images/image3.webp" class="d-block w-100"
                            style="height: 520px; object-fit: cover;"></div>
                    <div class="carousel-item"><img src="/images/image4.webp" class="d-block w-100"
                            style="height: 520px; object-fit: cover;"></div>
                    <div class="carousel-item"><img src="/images/image5.webp" class="d-block w-100"
                            style="height: 520px; object-fit: cover;"></div>
                </div>
            </div>
        </section>

        <% if (stories && stories.length> 0) {
            const categoryConfig = [
            { id: 'explore', label: 'Explore Stories' },
            { id: 'hiragana', label: 'Hiragana Reads' },
            { id: 'katakana', label: 'Katakana Reads' },
            { id: 'manga', label: 'Manga' },
            { id: 'manhwa', label: 'Manhwa' },
            { id: 'folk', label: 'Folk Stories' }
            ];

            categoryConfig.forEach((cat) => {
            const filtered = stories.filter(s => s.story_category && s.story_category.includes(cat.id));
            if(filtered.length > 0) {
            const chunks = [];
            for (let i = 0; i < filtered.length; i +=5) { let chunk=filtered.slice(i, i + 5); if (chunk.length < 5 &&
                filtered.length>= 5) {
                const needed = 5 - chunk.length;
                const fill = filtered.slice(0, needed);
                chunk = [...chunk, ...fill];
                }
                chunks.push(chunk);
                }
                %>
                <section class="section-block">
                    <h2 class="category-title">
                        <%= cat.label %>
                    </h2>
                    <div class="carousel-container">
                        <div id="carousel-<%= cat.id %>" class="carousel slide" data-bs-interval="false">
                            <div class="carousel-inner">
                                <% chunks.forEach((chunk, index)=> { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <div class="row g-3">
                                            <% chunk.forEach(story=> { %>
                                                <div class="col"
                                                    style="flex: 0 0 18%; max-width: 18%; margin-right: 20px">
                                                    <div class="card-wrapper">
                                                        <img src="/uploads/<%= story.story_image_vertical %>"
                                                            class="main-poster">
                                                        <div class="card-popout">
                                                            <img src="/uploads/<%= story.story_image_horizontal %>">
                                                            <div class="popout-body">
                                                                <h5 class="item-name">
                                                                    <%= story.story_name %>
                                                                </h5>
                                                                <p class="item-desc">
                                                                    <%= story.story_description %>
                                                                </p>
                                                                <a href="/story/<%= story._id %>"
                                                                    class="text-decoration-none">
                                                                    <button class="watch-now-btn">Read Now</button>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% if (filtered.length> 5) { %>
                                <button class="carousel-control-prev" type="button"
                                    data-bs-target="#carousel-<%= cat.id %>" data-bs-slide="prev">
                                    <i class="bi bi-chevron-left fs-2"></i>
                                </button>
                                <button class="carousel-control-next" type="button"
                                    data-bs-target="#carousel-<%= cat.id %>" data-bs-slide="next">
                                    <i class="bi bi-chevron-right fs-2"></i>
                                </button>
                                <% } %>
                        </div>
                    </div>
                </section>
                <% } }); } else { %>
                    <div class="text-center py-5 mt-5">
                        <h3 class="text-secondary">Library is currently empty</h3>
                    </div>
                    <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
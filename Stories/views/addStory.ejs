<!DOCTYPE html>
<html lang="en" style="height: auto; min-height: 100%;">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Content</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-gradient-to-br from-black via-neutral-900 to-neutral-800 text-neutral-200 antialiased"
    style="height: auto; min-height: 100%;">

    <div class="min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8">

        <!-- Dark Card -->
        <div class="w-full max-w-lg bg-neutral-900 rounded-2xl shadow-2xl p-8 sm:p-10 animate-fadeInUp gradient-border">

            <!-- Header -->
            <div class="mb-8 text-center">
                <h1
                    class="text-4xl font-bold bg-gradient-to-r from-neutral-200 to-neutral-400 bg-clip-text text-transparent mb-2">
                    Add New Content</h1>
                <div class="w-24 h-1 bg-gradient-to-r from-neutral-500 to-neutral-700 mx-auto rounded-full"></div>
            </div>

            <!-- Form -->
            <form method="POST" action="/addStory" enctype="multipart/form-data" id="contentForm" class="space-y-6">

                <div class="space-y-6">

                    <!-- Story Name -->
                    <div class="space-y-2">
                        <label for="storyName" class="block text-sm font-semibold text-neutral-300">Story Name</label>
                        <input type="text" id="storyName" name="story_name" required
                            class="w-full px-4 py-3 rounded-lg border-2 border-neutral-700 bg-neutral-800 text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-neutral-500 focus:ring-2 focus:ring-neutral-700 transition-all duration-300 hover:border-neutral-600"
                            placeholder="Enter your story name">
                    </div>

                    <!-- Category (Checkboxes) -->
                    <div class="space-y-3">
                        <label class="block text-sm font-semibold text-neutral-300">Categories (Select all that
                            apply)</label>
                        <div
                            class="grid grid-cols-2 gap-4 p-4 rounded-lg border-2 border-neutral-700 bg-neutral-800/50">

                            <label class="flex items-center space-x-3 cursor-pointer group">
                                <input type="checkbox" name="story_category" value="explore"
                                    class="w-5 h-5 rounded border-neutral-600 bg-neutral-700 text-neutral-500 focus:ring-offset-neutral-900 focus:ring-neutral-500">
                                <span
                                    class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors">Explore
                                    Stories</span>
                            </label>

                            <label class="flex items-center space-x-3 cursor-pointer group">
                                <input type="checkbox" name="story_category" value="hiragana"
                                    class="w-5 h-5 rounded border-neutral-600 bg-neutral-700 text-neutral-500 focus:ring-offset-neutral-900 focus:ring-neutral-500">
                                <span
                                    class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors">Hiragana
                                    Reads</span>
                            </label>

                            <label class="flex items-center space-x-3 cursor-pointer group">
                                <input type="checkbox" name="story_category" value="katakana"
                                    class="w-5 h-5 rounded border-neutral-600 bg-neutral-700 text-neutral-500 focus:ring-offset-neutral-900 focus:ring-neutral-500">
                                <span
                                    class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors">Katakana
                                    Reads</span>
                            </label>

                            <label class="flex items-center space-x-3 cursor-pointer group">
                                <input type="checkbox" name="story_category" value="manga"
                                    class="w-5 h-5 rounded border-neutral-600 bg-neutral-700 text-neutral-500 focus:ring-offset-neutral-900 focus:ring-neutral-500">
                                <span
                                    class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors">Manga</span>
                            </label>

                            <label class="flex items-center space-x-3 cursor-pointer group">
                                <input type="checkbox" name="story_category" value="manhwa"
                                    class="w-5 h-5 rounded border-neutral-600 bg-neutral-700 text-neutral-500 focus:ring-offset-neutral-900 focus:ring-neutral-500">
                                <span
                                    class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors">Manhwa</span>
                            </label>

                            <label class="flex items-center space-x-3 cursor-pointer group">
                                <input type="checkbox" name="story_category" value="folk"
                                    class="w-5 h-5 rounded border-neutral-600 bg-neutral-700 text-neutral-500 focus:ring-offset-neutral-900 focus:ring-neutral-500">
                                <span
                                    class="text-sm text-neutral-400 group-hover:text-neutral-200 transition-colors">Folk
                                    Stories</span>
                            </label>
                        </div>
                    </div>

                    <!-- Vertical Image Upload (Poster) -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-neutral-300">Vertical Poster Image (2:3
                            Ratio)</label>
                        <div class="flex items-center gap-4">
                            <label for="verticalUpload" class="flex-1 cursor-pointer">
                                <div
                                    class="flex items-center justify-center px-4 py-3 border-2 border-dashed border-neutral-700 rounded-lg hover:border-neutral-500 hover:bg-neutral-800 transition-all duration-300">
                                    <svg class="w-5 h-5 text-neutral-400 mr-2" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                        </path>
                                    </svg>
                                    <span class="text-sm text-neutral-400 font-medium">Vertical Poster</span>
                                </div>
                                <input type="file" id="verticalUpload" name="story_image_vertical" accept="image/*"
                                    onchange="previewImage(event, 'verticalPreview')" class="hidden" required>
                            </label>
                            <img id="verticalPreview"
                                class="hidden w-16 h-20 object-cover rounded-lg border-2 border-neutral-700 shadow-md"
                                alt="Preview">
                        </div>
                    </div>

                    <!-- Horizontal Image Upload (Hover) -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-neutral-300">Horizontal Hover Image (16:9
                            Ratio)</label>
                        <div class="flex items-center gap-4">
                            <label for="horizontalUpload" class="flex-1 cursor-pointer">
                                <div
                                    class="flex items-center justify-center px-4 py-3 border-2 border-dashed border-neutral-700 rounded-lg hover:border-neutral-500 hover:bg-neutral-800 transition-all duration-300">
                                    <svg class="w-5 h-5 text-neutral-400 mr-2" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                        </path>
                                    </svg>
                                    <span class="text-sm text-neutral-400 font-medium">Horizontal Hover</span>
                                </div>
                                <input type="file" id="horizontalUpload" name="story_image_horizontal" accept="image/*"
                                    onchange="previewImage(event, 'horizontalPreview')" class="hidden" required>
                            </label>
                            <img id="horizontalPreview"
                                class="hidden w-20 h-16 object-cover rounded-lg border-2 border-neutral-700 shadow-md"
                                alt="Preview">
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="space-y-2">
                        <label for="description"
                            class="block text-sm font-semibold text-neutral-300">Description</label>
                        <textarea id="description" name="story_description" rows="4" required
                            class="w-full px-4 py-3 rounded-lg border-2 border-neutral-700 bg-neutral-800 text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-neutral-500 focus:ring-2 focus:ring-neutral-700 transition-all duration-300 resize-none hover:border-neutral-600"
                            placeholder="Write a brief description..."></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="pt-2">
                        <button type="submit"
                            class="w-full py-3.5 px-6 rounded-lg bg-gradient-to-r from-neutral-700 to-neutral-800 text-neutral-100 font-semibold hover:from-neutral-600 hover:to-neutral-700 active:scale-95 transition-all duration-300 shadow-lg hover:shadow-xl">
                            Submit Content
                        </button>
                    </div>

                </div>
            </form>
        </div>

    </div>

    <script>
        function previewImage(event, previewId) {
            const input = event.target;
            const preview = document.getElementById(previewId);

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>

</html>